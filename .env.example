# Copy this file to ".env" and fill in the two values from Supabase → Project Settings → API Keys.
# Both values are public by design (the app ships them); data is protected by the database rules (RLS).
# Never put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_YOUR_KEY
